# Copy this file to .env for local development.
# Values containing angle brackets are placeholders and must be replaced.

APP_ENV=development
LOG_LEVEL=INFO
DOCS_ENABLED=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=["http://localhost:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

POSTGRES_DB=<local-database-name>
POSTGRES_USER=<local-database-user>
POSTGRES_PASSWORD=<local-database-password>
DATABASE_URL=postgresql+psycopg://<local-database-user>:<local-database-password>@postgres:5432/<local-database-name>
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=<local-access-key>
MINIO_SECRET_KEY=<local-secret-key>
MINIO_BUCKET_DOCUMENTS=documents

REDIS_URL=redis://redis:6379/0
VITE_API_BASE_URL=http://localhost:8000/api/v1
